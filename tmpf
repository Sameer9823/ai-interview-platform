import { NextResponse } from "next/server";
import { getCurrent } from "@/lib/auth/session";
import { db } from "@/lib/db/client";
type PracticeStatus = "IN_PROGRESS" | "COMPLETED" | "ABANDONED";
type PracticeStatus = "IN_PROGRESS" | "COMPLETED" | "ABANDONED";

export async function GET(
  req: Request,
  { params }: { params: Promise<{ id: string }> }
) {
  const { session, record } = await getCurrent();
  if (!session || !record) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  const { id } = await params;

  const practiceSession = await db.practiceSession.findUnique({
    where: { id },
    include: {
      questions: {
        orderBy: { position: "asc" },
        include: { generatedQuestion: true },
      },
      answers: {
        include: { evaluation: true },
        orderBy: { submittedAt: "asc" },
      },
    },
  });

  if (!practiceSession || practiceSession.userId !== record.id) {
    return NextResponse.json({ error: "Not found" }, { status: 404 });
  }

  return NextResponse.json({ session: practiceSession });
}

export async function PATCH(
  req: Request,
  { params }: { params: Promise<{ id: string }> }
) {
  const { session, record } = await getCurrent();
  if (!session || !record) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  const { id } = await params;
  const body = await req.json().catch(() => null);
  if (!body) return NextResponse.json({ error: "Invalid input" }, { status: 400 });

  const practiceSession = await db.practiceSession.findUnique({ where: { id } });
  if (!practiceSession || practiceSession.userId !== record.id) {
    return NextResponse.json({ error: "Not found" }, { status: 404 });
  }

  const updateData: Record<string, unknown> = {};
  if (body.status && ["IN_PROGRESS", "COMPLETED", "ABANDONED"].includes(body.status)) {
    updateData.status = body.status;
    if (body.status === "COMPLETED") updateData.completedAt = new Date();
  }
  if (body.title) updateData.title = body.title;

  const updated = await db.practiceSession.update({
    where: { id },
    data: updateData,
  });

  return NextResponse.json({ session: updated });
}
