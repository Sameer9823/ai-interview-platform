# Copy to .env and fill in. Never commit real values.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/interviewpilot?schema=public"

# --- Auth ---
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# --- Branding and contact (all optional) ---
NEXT_PUBLIC_APP_NAME="InterviewPilot"
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- AI (all optional: the app works without any of these) ---
# Provider: openai | anthropic | google. Each needs its own key and a model name you choose.
AI_PROVIDER=""
AI_MODEL=""
OPENAI_API_KEY="replace-me"
ANTHROPIC_API_KEY="replace-me"
GOOGLE_API_KEY="replace-me"
AI_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
# Stops AI calls once estimated spend reaches this many USD (per server process). Empty means no cap.
AI_BUDGET_USD=""

# --- Phase 3: AI Usage Limits (optional, server-side) ---
# Daily limits per user for each operation type
AI_LIMIT_QGEN_REQUESTS_DAY="20"
AI_LIMIT_QGEN_PER_REQUEST="10"
AI_LIMIT_EVAL_REQUESTS_DAY="50"
AI_LIMIT_EXPLANATION_REQUESTS_DAY="30"
AI_LIMIT_PLAN_REQUESTS_DAY="5"
# Input/output length limits
AI_LIMIT_MAX_INPUT_LENGTH="50000"
AI_LIMIT_MAX_OUTPUT_LENGTH="8000"

# --- Administration ---
# Production: nobody is promoted automatically. After the person has signed up and verified their email, an operator runs:
#   npm run admin:grant -- someone@example.com        (add --revoke to remove access)
# Dev and test only: grants admin to ONE email at sign up in the in memory store. Unsafe with real users because
# email verification is not built yet. Leave both empty anywhere that is reachable by other people.
ALLOW_DEV_ADMIN=""
DEV_ADMIN_EMAIL=""

# --- Search check (optional) ---
# Used only by `npm run fts:check` to test the PostgreSQL search SQL on throwaway tables.
FTS_CHECK_URL=""

# --- Dev only ---
# The in memory user store warns in production. Set to 1 only to silence it knowingly.
ALLOW_DEV_STORE=""
