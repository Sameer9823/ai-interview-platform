  careerStage     CareerStage?
  overallScore    Float?
  evidenceCoverage Float?
  snapshotData    Json
  methodologyVersion String @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, targetRole])
  @@index([userId, createdAt(sort: Desc)])
}

model SkillEvidenceAggregate {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId                 String
  skillName               String
  category                String
  classification          SkillEvidenceClassification
  proficiencyScore        Float?
  confidence              Float?
  totalEvidenceCount      Int      @default(0)
  demonstratedCount       Int      @default(0)
  selfReportedCount       Int      @default(0)
  lastDemonstratedAt      DateTime?
  lastAssessedAt          DateTime?
  evidenceSources         Json     @default("[]")
  sourceRecordIds         String[]
  targetRoles             String[]
  rubricVersion           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId, category])
  @@index([userId, classification])
  @@index([userId, proficiencyScore(sort: Desc)])
}

model RoleFramework {
  id              String   @id @default(cuid())
  identifier      String   @unique
  name            String
  description     String
  category        String
  status          RoleFrameworkStatus @default(DRAFT)
  currentVersion  Int      @default(1)
  methodologyVersion String  @default("1.0")
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        RoleFrameworkVersion[]
  skills          RoleSkillRequirement[]
  readinessAssessments ReadinessAssessment[]
  skillGapAnalyses      SkillGapAnalysis[]
}

model RoleFrameworkVersion {
  id              String       @id @default(cuid())
  frameworkId     String
  framework       RoleFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  version         Int
  changeReason    String
  snapshot        Json
  createdBy       String?
  createdAt       DateTime     @default(now())

  @@unique([frameworkId, version])
  @@index([frameworkId])
}

model RoleSkillRequirement {
  id              String       @id @default(cuid())
  frameworkId     String
  framework       RoleFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  skillId         String
  skillName       String
  category        String
  importance      Float        @default(1.0) // 0.0 - 1.0
  isRequired      Boolean      @default(true)
  expectedProficiency Float    @default(70.0) // 0-100
  prerequisites   String[]     @default([])
  evidenceTypes   String[]     @default([])
  assessmentRecommendations String[] @default([])
  practiceRecommendations String[] @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([frameworkId, skillId])
  @@index([frameworkId, importance(sort: Desc)])
  @@index([frameworkId, category])
}

model SkillPrerequisite {
  id              String   @id @default(cuid())
  skillId         String
  skillName       String
  prerequisiteId  String
  prerequisiteName String
  relationshipType String  @default("REQUIRED") // REQUIRED | RECOMMENDED | HELPFUL
  createdAt       DateTime @default(now())

  @@unique([skillId, prerequisiteId])
  @@index([skillId])
  @@index([prerequisiteId])
}

model ReadinessAssessment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String
  careerStage     CareerStage?
  frameworkId     String?
  framework       RoleFramework? @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  overallReadiness ReadinessLevel
  overallScore    Float
  dimensionResults Json
  evidenceCoverage Json
  limitations     String?
  methodologyVersion String @default("1.0")
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dimensionDetails ReadinessDimensionDetail[]

  @@index([userId, targetRole])
  @@index([userId, generatedAt(sort: Desc)])
  @@unique([userId, targetRole, methodologyVersion])
}

model ReadinessDimensionDetail {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      ReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimension       ReadinessDimension
  level           ReadinessLevel
  score           Float
  evidenceCount   Int
  demonstratedSkills String[]
  missingSkills   String[]
  selfReportedSkills String[]
  needsAssessment String[]
  explanation     String
  createdAt       DateTime @default(now())

  @@index([assessmentId])
  @@unique([assessmentId, dimension])
}

model SkillGapAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String
  frameworkId     String?
  framework       RoleFramework? @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  gaps            Json
  prioritizedGaps Json
  methodologyVersion String @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, targetRole])
  @@index([userId, createdAt(sort: Desc)])
}

model CareerRecommendation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            RecommendationType
  priority        RecommendationPriority
  title           String
  description     String
  explanation     String
  evidence        Json     @default("[]")
  targetSkillId   String?
  targetSkillName String?
  targetRole      String?
  relatedFrameworkId String?
  suggestedActions Json    @default("[]")
  estimatedMinutes Int?
  expectedOutcome String?
  route           String?
  actionLabel     String?
  status          String   @default("PENDING") // PENDING | ACCEPTED | DISMISSED | SNOOZED | COMPLETED
  dismissedAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  methodologyVersion String @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, priority, createdAt(sort: Desc)])
  @@index([userId, targetRole])
  @@index([targetSkillId])
}

model CareerReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String
  status          CareerReportStatus @default(DRAFT)
  reportVersion   Int      @default(1)
  methodologyVersion String @default("1.0")
  reportData      Json
  generatedAt     DateTime?
  generatedBy     String?  // "SYSTEM" | userId
  pdfStorageKey   String?
  pdfGeneratedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        CareerReportVersion[]

  @@index([userId, targetRole])
  @@index([userId, createdAt(sort: Desc)])
}

model CareerReportVersion {
  id              String       @id @default(cuid())
  reportId        String
  report          CareerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version         Int
  changeReason    String
  snapshot        Json
  createdBy       String?
  createdAt       DateTime     @default(now())

  @@unique([reportId, version])
  @@index([reportId])
}

model ScoringMethodologyVersion {
  id              String   @id @default(cuid())
  version         String   @unique
  name            String
  description     String
  rulesJson       Json
  isActive        Boolean  @default(false)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model CareerIntelligenceSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultTargetRole String?
  preferredFrameworkId String?
  notificationEnabled Boolean @default(true)
  autoGenerateReports Boolean @default(false)
  reportFrequency  String?  // WEEKLY | BIWEEKLY | MONTHLY
  includeVoiceMetrics Boolean @default(false)
  privacyLevel     String   @default("PRIVATE") // PRIVATE | ANONYMOUS_AGGREGATE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

