  topic         CommunityTopic  @relation(fields: [topicId], references: [id])
  authorId      String
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  questionId    String?
  question      Question?       @relation(fields: [questionId], references: [id])
  visibility    PostVisibility  @default(PUBLIC)
  imageUrl      String?
  resourceUrl   String?
  isPinned      Boolean         @default(false)
  viewCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  comments      CommunityComment[]
  reactions     PostReaction[]
  savedBy       SavedCommunityPost[]

  @@index([topicId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([isPinned, createdAt(sort: Desc)])
}

model CommunityComment {
  id            String           @id @default(cuid())
  postId        String
  post          CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        CommunityComment? @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies       CommunityComment[] @relation("CommentTree")
  content       String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([postId, createdAt(sort: Desc)])
  @@index([parentId, createdAt(sort: Desc)])
}

model PostReaction {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  String        // e.g. "LIKE", "INSIGHTFUL", "CELEBRATE"
  createdAt DateTime      @default(now())

  @@unique([postId, userId, reaction])
  @@index([postId])
  @@index([userId])
}

model SavedCommunityPost {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
}

model CommunityReport {
  id          String           @id @default(cuid())
  reporterId  String
  reporter    User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String           // POST | COMMENT | GROUP | USER
  targetId    String           // polymorphic
  reason      ReportReason
  details     String?
  status      ReportStatus     @default(PENDING)
  reviewerId  String?
  reviewer    User?            @relation("Reviewer", fields: [reviewerId], references: [id])
  actionTaken String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model StudyGroup {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String
  about           String?
  category        String
  targetRole      String?
  targetCompany   String?
  skill           String?
  careerStage     CareerStage?
  maxMembers      Int               @default(50)
  visibility      GroupVisibility   @default(PUBLIC)
  rules           Json?
  imageUrl        String?
  memberCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  memberships     StudyGroupMembership[]
  invitations     StudyGroupInvitation[]
  joinRequests    StudyGroupJoinRequest[]
  discussions     GroupDiscussion[]
  resources       GroupResource[]
  sessions        StudySession[]
  challenges      GroupChallenge[]
  pinnedItems     GroupPinnedItem[]
  messages        GroupMessage[]
}

model StudyGroupMembership {
  id        String    @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole  @default(MEMBER)
  joinedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model StudyGroupInvitation {
  id        String   @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User     @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([groupId, inviteeId])
  @@index([inviterId])
}

model StudyGroupJoinRequest {
  id        String       @id @default(cuid())
  groupId   String
  group     StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    JoinRequestStatus @default(PENDING)
  respondedById String?
  respondedBy   User?    @relation("JoinResponder", fields: [respondedById], references: [id])
  respondedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId, status])
}

model GroupDiscussion {
  id        String    @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])
  title     String
  content   String
  isPinned  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  replies   GroupDiscussionReply[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([isPinned, createdAt(sort: Desc)])
}

model GroupDiscussionReply {
  id          String        @id @default(cuid())
  discussionId String
  discussion  GroupDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      GroupDiscussionReply? @relation("ReplyTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies     GroupDiscussionReply[] @relation("ReplyTree")
  content     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([discussionId, createdAt(sort: Desc)])
  @@index([parentId, createdAt(sort: Desc)])
}

model GroupMessage {
  id        String    @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([groupId, createdAt(sort: Desc)])
  @@index([senderId])
}

model GroupPinnedItem {
  id        String   @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemType  String   // DISCUSSION | RESOURCE | SESSION | CHALLENGE
  itemId    String
  pinnedById String
  pinnedBy  User     @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, itemType, itemId])
}

model GroupResource {
  id          String    @id @default(cuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resourceId  String?
  resource    LearningResource? @relation(fields: [resourceId], references: [id])
  addedById   String
  addedBy     User        @relation("ResourceAdder", fields: [addedById], references: [id], onDelete: Cascade)
  title       String
  description String?
  url          String?
  fileKey      String?
  fileSize     Int?
  mimeType     String?
  resourceType String
  topic        String?
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([groupId, resourceType])
  @@index([addedById])
}

model StudySession {
  id        String    @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  description String?
  subject    String
  startTime  DateTime
  endTime    DateTime
  timezone   String     @default("UTC")
  meetingLink String?
  maxParticipants Int?
  createdBy  String
  creator    User       @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  status     String     @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  attendees    StudySessionAttendance[]
  @@index([groupId, startTime])
  @@index([startTime])
}

model StudySessionAttendance {
  id        String   @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvp      String   @default("GOING") // GOING | INTERESTED | NOT_GOING
  joinedAt  DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId, sessionId])
}

model GroupChallenge {
  id              String    @id @default(cuid())
  groupId         String
  group           StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  challengeType   String
  startDate       DateTime
  endDate         DateTime
  targetValue     Int
  xpReward        Int?
  createdBy       String
  creator         User        @relation("ChallengeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  status          GroupChallengeStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participations  GroupChallengeParticipation[]

  @@index([groupId])
  @@index([startDate, endDate])
}

model GroupChallengeParticipation {
  id          String   @id @default(cuid())
  challengeId String
  challenge   GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Int         @default(0)
  targetValue Int
  status      String      @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  lastRecordedActivityAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([challengeId, userId])
  @@index([userId, challengeId])
}

model CommunityPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifyFollows Boolean @default(true)
  notifyComments Boolean @default(true)
  notifyMentions Boolean @default(true)
  notifyGroupInvites Boolean @default(true)
  notifyGroupDiscussions Boolean @default(true)
  notifyChallengeUpdates Boolean @default(true)
  notifySessionReminders Boolean @default(true)
  profileVisibility String @default("PUBLIC") // PUBLIC | COMMUNITY | PRIVATE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// PHASE 8: Personalized Career Roadmap & Adaptive Learning Plan Engine
// ============================================================================

enum CareerGoalStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum RoadmapStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum RoadmapTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
  CANCELLED
}

enum RoadmapTaskType {
  READ_RESOURCE
  WATCH_VIDEO
  STUDY_CONCEPT
  COMPLETE_PRACTICE_QUESTIONS
  COMPLETE_CODING_EXERCISE
  COMPLETE_ASSESSMENT
  PRACTICE_BEHAVIORAL_ANSWERS
  COMPLETE_MOCK_INTERVIEW
  REVIEW_RESUME_RECOMMENDATION
  REVISE_WEAK_TOPICS
  COMPLETE_MILESTONE_REVIEW
}

enum SkillEvidenceType {
  RESUME_ANALYSIS
  USER_CONFIRMED
  PRACTICE_EVALUATION
  ASSESSMENT_RESULT
  CODING_EVALUATION
  MOCK_INTERVIEW
  BEHAVIORAL_INTERVIEW
  VOICE_INTERVIEW
  SELF_REPORTED
  ROADMAP_TASK
  JOB_DESCRIPTION_ANALYSIS
  OPPORTUNITY_MATCH
  COMPANY_QUESTION
  EXTERNAL_CERTIFICATION
  MENTIONED_NOT_DEMONSTRATED
  NOT_FOUND
  NEEDS_ASSESSMENT
}

enum SkillEvidenceClassification {
  CONSISTENTLY_DEMONSTRATED
  DEMONSTRATED
  PARTIALLY_DEMONSTRATED
  SELF_REPORTED
  MENTIONED_NOT_DEMONSTRATED
  NOT_FOUND
  INSUFFICIENT_EVIDENCE
  NEEDS_ASSESSMENT
}

enum RoadmapRecommendationType {
  PRACTICE_SKILL
  REVISE_TOPIC
  COMPLETE_TASK
  TAKE_ASSESSMENT
  TAKE_MOCK_INTERVIEW
  REVISE_RESUME
  UPDATE_GOALS
  CHANGE_PRIORITIES
}

enum LearningResourceType {
  QUESTION_BANK
  COMPANY_PREP
  ASSESSMENT
  CODING_EXERCISE
  MOCK_INTERVIEW
  RESUME_RECOMMENDATION
  OFFICIAL_DOCUMENTATION
  EDUCATIONAL_ARTICLE
  TUTORIAL
  VIDEO_RESOURCE
  PRACTICE_DATASET
  LEARNING_GUIDE
}

enum ResourceAccessType {
  FREE
  PAID
  SUBSCRIPTION
  PARTIAL
  UNKNOWN
}

enum ResourceVerificationStatus {
  VERIFIED
  PENDING
  UNVERIFIED
  UNVERIFIABLE
}

enum RoadmapRecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  IMPLEMENTED
}

enum SkillGapPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  OPTIONAL
}

model CareerGoal {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String
  careerStage     CareerStage?
  targetCompany   String?
  targetIndustry  String?
  targetDate      DateTime?
  weeklyHours     Float             @default(10)
  experienceLevel ExperienceLevel?
  currentRole     String?
  currentIndustry String?
  preferences     Json
  status          CareerGoalStatus  @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  roadmaps        CareerRoadmap[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model CareerRoadmap {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId          String?
  goal            CareerGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  status          RoadmapStatus @default(DRAFT)
  currentVersion  Int           @default(1)
  startDate       DateTime      @default(now())
  targetDate      DateTime?
  weeklyHourBudget Float        @default(10)
  summary         String
  methodologyVersion String     @default("1.0")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  versions              RoadmapVersion[]
  milestones            RoadmapMilestone[]
  tasks                 RoadmapTask[]
  recommendations       RoadmapRecommendation[] @relation("RoadmapRecommendations")
  skillGaps             SkillGapRecord[] @relation("RoadmapSkillGaps")
  recommendationEngines RoadmapRecommendationEngine[] @relation("RoadmapRecommendationEngineRoadmap")
  adaptationLogs        RoadmapAdaptationLog[] @relation("RoadmapAdaptationLogs")

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model RoadmapVersion {
  id          String        @id @default(cuid())
  roadmapId   String
  roadmap     CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  version     Int
  changeReason String
  summary     Json
  createdAt   DateTime      @default(now())

  @@unique([roadmapId, version])
}

model RoadmapMilestone {
  id              String         @id @default(cuid())
  roadmapId       String
  roadmap         CareerRoadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title           String
  description     String
  order           Int
  targetDate      DateTime?
  completionCriteria Json
  status          RoadmapTaskStatus @default(NOT_STARTED)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tasks           RoadmapTask[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model RoadmapTask {
  id              String            @id @default(cuid())
  roadmapId       String
  roadmap         CareerRoadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       RoadmapMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String
  taskType        RoadmapTaskType
  skillTags       String[]
  skillIds        String[]
  estimatedMinutes Int             @default(60)
  priority        Int             @default(2) // 1=high, 2=medium, 3=low
  prerequisites   String[]
  dueDate         DateTime?
  status          RoadmapTaskStatus @default(NOT_STARTED)
  completionSource String?          // USER_REPORTED | VERIFIED_EVALUATION | LINKED_ACTIVITY
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

prerequisiteLinks    RoadmapTaskPrerequisite[] @relation("TaskPrerequisites")
  dependentTasks     RoadmapTaskPrerequisite[] @relation("TaskPrerequisiteOf")

  @@index([roadmapId, status])
  @@index([roadmapId, milestoneId])
  @@index([roadmapId, dueDate])
}

model RoadmapTaskPrerequisite {
  id              String      @id @default(cuid())
  taskId          String
  task            RoadmapTask @relation("TaskPrerequisites", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteId  String
  prerequisite    RoadmapTask @relation("TaskPrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  @@unique([taskId, prerequisiteId])
  @@index([taskId])
  @@index([prerequisiteId])
}

model SkillEvidenceRecord {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skillName       String
  category        String
  evidenceType    SkillEvidenceType
  sourceRecordId  String?
  sourceRecordType String?
  evidenceText    String?
  classification  SkillEvidenceClassification
  proficiencyScore Float?              // 0-100
  rubricVersion   String?
  confidence      Float?
  evidenceDate    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, skillId])
  @@index([userId, category])
  @@index([userId, evidenceType])
}

model LearningResource {
  id              String              @id @default(cuid())
  title           String
  description     String
  resourceType    LearningResourceType
  canonicalUrl    String?
  internalRef     String?
  skillTags       String[]
  difficulty      Difficulty
  language        String              @default("en")
  estimatedMinutes Int?
  sourceOrg       String?
  accessType      ResourceAccessType
  attribution     String?
  license         String?
  verifiedAt      DateTime?
  verificationStatus ResourceVerificationStatus
  isOfficial      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  interactions    UserResourceInteraction[]
  groupResources  GroupResource[]

  @@index([resourceType, difficulty])
  @@index([skillTags])
  @@index([verificationStatus])
}

model UserResourceInteraction {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        LearningResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  interactionType String              // VIEWED | STARTED | COMPLETED | BOOKMARKED | RATED
  completionStatus String?            // COMPLETED | IN_PROGRESS | NOT_STARTED
  rating          Int?
  feedback        String?
  timeSpentMinutes Int?
  timestamp       DateTime            @default(now())

  @@unique([userId, resourceId, interactionType])
  @@index([userId, timestamp(sort: Desc)])
  @@index([resourceId, interactionType])
}

model RoadmapRecommendation {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
roadmapId       String?
  roadmap         CareerRoadmap?    @relation("RoadmapRecommendations", fields: [roadmapId], references: [id], onDelete: SetNull)
  type            RoadmapRecommendationType
  title           String
  description     String
  skillId         String?
  skillName       String?
  supportingEvidence Json                 @default("[]")
  explanation     String
  priority        Int                     @default(2)
  status          RoadmapRecommendationStatus @default(PENDING)
  relatedSkills   String[]
  suggestedActions Json
  confidence      Float?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([userId, status])
  @@index([roadmapId, status])
}

model SkillGapRecord {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId       String?
  roadmap         CareerRoadmap?    @relation("RoadmapSkillGaps", fields: [roadmapId], references: [id], onDelete: SetNull)
  skillId         String
  skillName       String
  category        String
  targetRole      String?
  // Evidence sources
  resumeEvidence  Json              @default("[]")
  assessmentEvidence Json          @default("[]")
  practiceEvidence Json            @default("[]")
  interviewEvidence Json           @default("[]")
  // Gap classification
  classification  String            // DEMONSTRATED | SELF_REPORTED | MENTIONED_NOT_DEMONSTRATED | NOT_FOUND | NEEDS_ASSESSMENT
  currentProficiency Float?         // 0-100
  targetProficiency Float?          // 0-100
  priority        SkillGapPriority  @default(MEDIUM)
  confidence      Float?
  suggestedAction String?
  recommendedResources Json        @default("[]")
  lastEvaluated   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, skillId])
  @@index([roadmapId, priority])
  @@index([userId, classification])
}

model RoadmapRecommendationEngine {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId       String?
  roadmap         CareerRoadmap?    @relation("RoadmapRecommendationEngineRoadmap", fields: [roadmapId], references: [id], onDelete: SetNull)
  contextSnapshot Json
  recommendations Json
  generatedAt     DateTime          @default(now())
  modelVersion    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model ReadinessIndicator {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole      String
  careerStage     CareerStage?
  overallScore    Float?
  skillBreakdown  Json
  evidenceCoverage Json
  limitations     String?
  generatedAt     DateTime          @default(now())
  rubricVersion   String            @default("1.0")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, targetRole])
  @@unique([userId, targetRole, rubricVersion])
}

model RoadmapAdaptationLog {
  id              String            @id @default(cuid())
  roadmapId       String
  roadmap         CareerRoadmap     @relation("RoadmapAdaptationLogs", fields: [roadmapId], references: [id], onDelete: Cascade)
