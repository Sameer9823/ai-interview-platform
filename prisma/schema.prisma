enum MockInterviewMode {
  HR_BEHAVIORAL
  TECHNICAL
  CODING
  SYSTEM_DESIGN
  COMPANY_SPECIFIC
  RESUME_BASED
  JOB_DESCRIPTION_BASED
  MIXED
  CUSTOM
}

enum MockInterviewStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MockInterviewDifficulty {
  EASY
  MEDIUM
  HARD
  ADAPTIVE
}

enum MockInterviewFeedbackMode {
  AFTER_EACH
  AT_END
}

enum MockInterviewStyle {
  SUPPORTIVE
  STANDARD
  CHALLENGING
}

enum MockInterviewTurnType {
  QUESTION
  FOLLOW_UP
  HINT
  CLARIFICATION
  END
}

model MockInterviewSession {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            MockInterviewMode
  targetRole      String?
  careerLevel     ExperienceLevel?
  companyId       String?
  company         Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  resumeVersionId String?
  resumeVersion   ResumeVersion?       @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  jobDescriptionSnapshot Json?
  contextSnapshot Json?
  configuration   Json
  interviewPlan   Json?
  status          MockInterviewStatus  @default(DRAFT)
  difficulty      MockInterviewDifficulty @default(MEDIUM)
  questionCount   Int                  @default(10)
  durationMinutes Int                  @default(30)
  topics          String[]
  skills          String[]
  codingLanguage  String?
  feedbackMode    MockInterviewFeedbackMode @default(AT_END)
  interviewStyle  MockInterviewStyle   @default(STANDARD)
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

questions       MockInterviewQuestion[]
  answers         MockInterviewAnswer[]
  evaluations     MockInterviewEvaluation[]
  report          MockInterviewReport?
  generationJobs  MockInterviewGenerationJob[]
  voiceSession    VoiceSession?
  jobApplications JobApplication[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model MockInterviewQuestion {
  id              String               @id @default(cuid())
  sessionId       String
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequenceNumber  Int
  turnType        MockInterviewTurnType @default(QUESTION)
  questionType    QuestionType
  questionText    String
  topicTags       String[]
  difficulty      Difficulty
  sourceType      ContentOrigin
  sourceReference String?
  evaluationRubric Json
  expectedAnswerMetadata Json?
  createdAt       DateTime             @default(now())

  answers         MockInterviewAnswer[]
  evaluations   MockInterviewEvaluation[]

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId])
}

model MockInterviewAnswer {
  id              String               @id @default(cuid())
  sessionId       String
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        MockInterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerText      String?
  answerCode      String?
  programmingLanguage String?
  status          String               @default("SUBMITTED") // SUBMITTED | SKIPPED | HINT_REQUESTED
  idempotencyKey  String               @unique
  submittedAt     DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  evaluation      MockInterviewEvaluation?

  @@index([sessionId, questionId])
  @@index([userId])
}

model MockInterviewEvaluation {
  id              String               @id @default(cuid())
  sessionId       String
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        MockInterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId        String
  answer          MockInterviewAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  rubricVersion   String
  dimensionScores Json
  overallScore    Int?
  strengths       String[]
  improvements    String[]
  missingConcepts String[]
  evidence        Json
  confidenceStatus String?
  evaluationStatus String             @default("COMPLETED") // COMPLETED | PENDING_REVIEW | FAILED
  createdAt       DateTime             @default(now())

  @@unique([answerId])
  @@index([sessionId])
}

model MockInterviewReport {
  id              String               @id @default(cuid())
  sessionId       String               @unique
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportVersion   Int                  @default(1)
  overallScore    Int?
  skillBreakdown  Json
  summary         String
  recommendations Json
  evaluationCoverage Json
  limitations     String?
  generatedAt     DateTime             @default(now())

  @@index([userId])
}

model MockInterviewGenerationJob {
  id          String   @id @default(cuid())
  sessionId   String
  session     MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String   // PLAN_GENERATION | QUESTION_GENERATION | FOLLOW_UP | EVALUATION | REPORT_GENERATION
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED
  inputJson   Json?
  outputJson  Json?
  errorMessage String?
  attempts    Int      @default(0)
  maxRetries  Int      @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId, type])
  @@index([status, createdAt])
}


// ============================================================================
// PHASE 7: Voice-Based Mock Interviews & Speech Analysis
// ============================================================================

enum VoiceProvider {
  OPENAI
  ELEVENLABS
  DEEPGRAM
  ASSEMBLYAI
  BROWSER_NATIVE
  AZURE
  GOOGLE_CLOUD
}

enum TranscriptionProvider {
  OPENAI_WHISPER
  DEEPGRAM
  ASSEMBLYAI
  BROWSER_NATIVE
  GOOGLE_CLOUD
  AZURE
}

enum VoiceMode {
  TEXT_ONLY
  VOICE_ONLY
  HYBRID
}

enum VoiceSessionStatus {
  IDLE
  PERMISSION_PENDING
  READY
  LISTENING
  TRANSCRIBING
  REVIEWING
  SUBMITTING
  WAITING_FOR_INTERVIEWER
  PLAYING_INTERVIEWER_AUDIO
  PAUSED
  ERROR
  CANCELLED
  COMPLETED
}

enum VoiceCaptureStatus {
  PENDING
  RECORDING
  UPLOADING
  PROCESSING
  TRANSCRIBING
  COMPLETED
  FAILED
  CANCELLED
}

model VoiceSession {
  id                    String            @id @default(cuid())
  sessionId             String            @unique
  session               MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  voiceMode             VoiceMode         @default(TEXT_ONLY)
  voiceProvider         VoiceProvider?    @default(BROWSER_NATIVE)
  transcriptionProvider TranscriptionProvider? @default(BROWSER_NATIVE)
  language              String            @default("en-US")
  voiceId               String?
  consentVersion        String?
  consentAt             DateTime?
  deliveryAnalyticsEnabled Boolean         @default(false)
  processingStatus      String            @default("IDLE")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  captures              VoiceCapture[]
  processingJobs        VoiceProcessingJob[]

  @@index([sessionId])
}

model VoiceCapture {
  id               String            @id @default(cuid())
  voiceSessionId   String
  voiceSession     VoiceSession      @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)
  questionId       String
  attemptId        String?
  captureStatus    VoiceCaptureStatus @default(PENDING)
  audioDuration    Int?              // in seconds
  mimeType         String?
  storageKey       String?
  deletionAt       DateTime?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transcript       VoiceTranscript?
  analysis         VoiceAnalysis?
  processingJobs   VoiceProcessingJob[]

  @@index([voiceSessionId, questionId])
  @@index([voiceSessionId, createdAt])
}

model VoiceTranscript {
  id              String         @id @default(cuid())
  captureId       String         @unique
  capture         VoiceCapture   @relation(fields: [captureId], references: [id], onDelete: Cascade)
  fullText        String
  language        String         @default("en-US")
  confidence      Float?
  isFinal         Boolean        @default(false)
  provider        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  segments        TranscriptSegment[]
}

model TranscriptSegment {
  id              String            @id @default(cuid())
  transcriptId    String
  transcript      VoiceTranscript   @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  index           Int
  text            String
  startMs         Int?
  endMs           Int?
  confidence      Float?
  isFinal         Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@unique([transcriptId, index])
  @@index([transcriptId])
}

model VoiceAnalysis {
  id                       String         @id @default(cuid())
  captureId                String         @unique
  capture                  VoiceCapture   @relation(fields: [captureId], references: [id], onDelete: Cascade)
  version                  String         @default("1.0")
  speakingDurationMs       Int?
  wordsPerMinute           Float?
  pauseCount               Int?
  avgPauseDurationMs       Float?
  fillerWordCount          Int?
  fillerWords              Json?
  transcriptClarityScore   Float?
  metricsJson              Json?
  reliability              String         @default("MEDIUM")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([captureId])
}

model VoiceProcessingJob {
  id               String         @id @default(cuid())
  sessionId        String
  session          VoiceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  captureId        String?
  capture          VoiceCapture?      @relation(fields: [captureId], references: [id])
  type             String
  status           String         @default("PENDING")
  provider         String?
  inputJson        Json?
  outputJson       Json?
  errorMessage     String?
  attempts         Int            @default(0)
  maxRetries       Int            @default(3)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([sessionId, type])
  @@index([status, createdAt])
  @@index([captureId])
}

model VoiceConsentLog {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  version          String
  accepted         Boolean
  ipHash           String?
  userAgent        String?
  createdAt        DateTime    @default(now())

  @@index([userId, createdAt])
}

model VoiceUsageRecord {
  id                String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  operation        String
  provider         String
  model            String?
  audioDurationMs  Int?
  characters       Int?
  estimatedCostUsd Float?
  createdAt        DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

