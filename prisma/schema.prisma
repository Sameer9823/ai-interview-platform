// InterviewPilot Phase 1 schema.
// Auth: Auth.js style Credentials with JWT sessions, so no Account/Session adapter tables are needed.
// Email verification and password reset use our own hashed single use tokens.
// `tokenVersion` lets the server invalidate all existing sessions (password change, sign out everywhere).
//
// Phase 2 (content) models are at the bottom. Phase 3+ extension points (not modelled yet): Assessment,
// AssessmentAttempt, Resume, ResumeAnalysis, InterviewSession. Each will hang off User with onDelete: Cascade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CareerStage {
  STUDENT
  FRESHER
  PROFESSIONAL
}

// Platform administration is deliberately separate from CareerStage.
enum PlatformRole {
  NONE
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum GoalCategory {
  TECHNICAL_INTERVIEWS
  APTITUDE_REASONING
  CODING_DSA
  BEHAVIORAL_HR
  SYSTEM_DESIGN
  COMMUNICATION
  CAREER_TRANSITION
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum ActivityType {
  ACCOUNT_CREATED
  SIGNED_IN
  ONBOARDING_COMPLETED
  PROFILE_UPDATED
  GOALS_UPDATED
  PREFERENCES_UPDATED
  SECURITY_SETTINGS_CHANGED
}

enum NotificationType {
  SYSTEM
  ACCOUNT
  PROFILE
  SECURITY
}

enum AuditAction {
  SIGN_UP
  SIGN_IN
  SIGN_IN_FAILED
  SIGN_OUT
  EMAIL_VERIFICATION_SENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CONFIRMED
  PERMISSION_DENIED
  ROLE_CHANGED
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  emailVerified         DateTime?
  passwordHash          String?
  name                  String
  // Null until onboarding step 1 is completed.
  careerStage           CareerStage?
  platformRole          PlatformRole @default(NONE)
  onboardingCompletedAt DateTime?
  tokenVersion          Int          @default(0)
  deletionRequestedAt   DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  profile       UserProfile?
  preference    UserPreference?
  goals         PreparationGoal[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  auditLogs     AuditLog[]
  verifyTokens  EmailVerificationToken[]
  resetTokens   PasswordResetToken[]
  savedQuestions SavedQuestion[]
  practiceSessions PracticeSession[]
  generatedQuestions GeneratedPracticeQuestion[]
  preparationPlans PreparationPlan[]
  aiUsage AIUsageRecord[]
assessmentAttempts AssessmentAttempt[]
  resumes Resume[]
  jobDescriptions JobDescription[]
  mockInterviewSessions MockInterviewSession[]
  mockInterviewAnswers MockInterviewAnswer[]
  mockInterviewReports MockInterviewReport[]
  voiceConsentLogs VoiceConsentLog[]
  voiceUsageRecords VoiceUsageRecord[]
  careerGoals CareerGoal[]
  careerRoadmaps CareerRoadmap[]
  skillEvidenceRecords SkillEvidenceRecord[]
  resourceInteractions UserResourceInteraction[]
  roadmapRecommendations RoadmapRecommendation[]
  recommendationEngines RoadmapRecommendationEngine[]
  skillGapRecords SkillGapRecord[]
  readinessIndicators ReadinessIndicator[]
   learningStreak LearningStreak?
  notificationPreferences NotificationPreference[]
  inAppNotifications InAppNotification[]
  gamificationProfile GamificationProfile?
  xpTransactions XPTransaction[]
  achievements UserAchievement[]
  challenges UserChallenge[]
  streakHistory LearningStreakHistory[]
  weeklyGoals WeeklyGoal[]
  personalBests PersonalBest[]
  leaderboardEntries LeaderboardEntry[]
  gamificationEvents GamificationEvent[]

  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  postReactions PostReaction[]
  followedTopics UserFollowedTopic[]
  savedCommunityPosts SavedCommunityPost[]
  reportedContent CommunityReport[] @relation("Reporter")
  reviewedReports CommunityReport[] @relation("Reviewer")
  followers UserFollow[] @relation("Follower")
  following UserFollow[] @relation("Following")
  blockedUsers UserBlock[] @relation("Blocker")
  blockedBy UserBlock[] @relation("Blocked")
  groupMemberships StudyGroupMembership[]
  invitedToGroups StudyGroupInvitation[]
  invitedGroups StudyGroupInvitation[] @relation("Inviter")
  groupJoinRequests StudyGroupJoinRequest[]
  joinRequestResponses StudyGroupJoinRequest[] @relation("JoinResponder")
  groupDiscussions GroupDiscussion[]
  groupDiscussionReplies GroupDiscussionReply[]
  sentMessages GroupMessage[]
  pinnedGroupItems GroupPinnedItem[]
  groupResourcesAdded GroupResource[] @relation("ResourceAdder")
  createdStudySessions StudySession[] @relation("SessionCreator")
  studySessionAttendances StudySessionAttendance[]
  createdChallenges GroupChallenge[] @relation("ChallengeCreator")
  challengeParticipations GroupChallengeParticipation[]
communityPreferences CommunityPreference[]

  // Phase 11: Career Opportunities & Application Tracking
  jobSearchPreference    JobSearchPreference?
  savedJobSearches       SavedJobSearch[]
  opportunityMatches     OpportunityMatch[]
  savedOpportunities     SavedOpportunity[]
  dismissedOpportunities DismissedOpportunity[]
  jobDescriptionAnalyses JobDescriptionAnalysis[]
  jobApplications        JobApplication[]

  // Phase 12: Career Intelligence
  careerIntelligenceSnapshots CareerIntelligenceSnapshot[]
  skillEvidenceAggregates    SkillEvidenceAggregate[]
  readinessAssessments       ReadinessAssessment[]
  skillGapAnalyses           SkillGapAnalysis[]
  careerRecommendations      CareerRecommendation[]
  careerReports              CareerReport[]
  careerIntelligenceSettings CareerIntelligenceSettings?

  @@index([careerStage])
  @@index([deletionRequestedAt])
}

// Career profile data, kept separate from authentication data on User.
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Common
  careerDomain      String?
  targetRole        String?
  preferredLanguage String           @default("en")
  experienceLevel   ExperienceLevel?

  // Student and fresher
  educationLevel             EducationLevel?
  degree                     String?
  graduationYear             Int?
  primaryProgrammingLanguage String?

  // Working professional
  currentRole       String?
  yearsOfExperience Int?
  skillsToImprove   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PreparationGoal {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  GoalCategory
  createdAt DateTime     @default(now())

  @@unique([userId, category])
  @@index([userId])
}

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              ThemePreference @default(SYSTEM)
  emailNotifications Boolean         @default(true)
  productUpdates     Boolean         @default(false)
  timezone           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Only a SHA-256 hash is stored. The raw token exists only in the emailed link.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  // Never store passwords, tokens or other secrets here.
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
}

// Survives account deletion: userId becomes null, the event record stays. Salted IP hash only.
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  ipHash    String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}


// ============================================================================
// PHASE 2: company knowledge base, question bank, experiences, sources, imports
// Full text search indexes cannot be expressed in Prisma. See prisma/sql/phase2_search.sql, applied
// through a custom migration (prisma migrate dev --create-only, then paste the SQL).
// ============================================================================

enum Publication {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  REJECTED
}

enum Verification {
  NOT_VERIFIED
  VERIFIED
  OUTDATED
  REJECTED
}

enum ContentOrigin {
  OFFICIAL
  CANDIDATE_REPORTED
  COMMUNITY_REPORTED
  ADMIN_CURATED
  PLATFORM_ORIGINAL
  AI_GENERATED
}

enum SourceType {
  OFFICIAL_CAREERS
  OFFICIAL_DOCS
  PUBLIC_EXPERIENCE
  EDUCATIONAL
  OPEN_DATASET
  GITHUB_REPO
  MANUAL_CURATION
  PLATFORM_ORIGINAL
  USER_SUBMITTED
}

enum UsePermission {
  APPROVED
  ATTRIBUTION_REQUIRED
  LINK_ONLY
  MANUAL_REVIEW_REQUIRED
  NOT_APPROVED
  UNKNOWN
}

enum Reliability {
  HIGH
  MEDIUM
  LOW
  UNRATED
}

enum SourceReview {
  UNREVIEWED
  REVIEWED
  REJECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_ANSWER
  SHORT_ANSWER
  LONG_ANSWER
  CODING
  SQL
  SCENARIO
  BEHAVIORAL
  SYSTEM_DESIGN
  COMMUNICATION
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoundKind {
  ONLINE_ASSESSMENT
  APTITUDE
  CODING
  TECHNICAL
  SYSTEM_DESIGN
  MANAGERIAL
  HR_BEHAVIORAL
  CASE_STUDY
  OTHER
}

enum ImportKind {
  QUESTIONS
  COMPANIES
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  FAILED
  BLOCKED
  ALREADY_IMPORTED
}

enum StagedStatus {
  VALID
  INVALID
  DUPLICATE
  SKIPPED
}

model Source {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  url             String        @unique
  domain          String
  type            SourceType
  publisher       String        @default("")
  description     String        @default("")
  licenseNotes    String        @default("")
  attribution     String        @default("")
  permission      UsePermission @default(UNKNOWN)
  commercialUse   UsePermission @default(UNKNOWN)
  redistribution  UsePermission @default(UNKNOWN)
  accessMethod    String        @default("")
  lastCheckedAt   DateTime?
  lastImportAt    DateTime?
  reliability     Reliability   @default(UNRATED)
  reviewStatus    SourceReview  @default(UNREVIEWED)
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  usages  ContentSource[]
  imports ImportJob[]

  @@index([type])
  @@index([permission])
}

// One row per (content item, source). Exactly one of the four item ids is set (CHECK constraint in phase2_search.sql).
model ContentSource {
  id           String  @id @default(cuid())
  sourceId     String
  source       Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  companyId    String?
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processId    String?
  process      InterviewProcess? @relation(fields: [processId], references: [id], onDelete: Cascade)
  questionId   String?
  question     Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  experienceId String?
  experience   Experience?       @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, companyId])
  @@unique([sourceId, processId])
  @@unique([sourceId, questionId])
  @@unique([sourceId, experienceId])
  @@index([companyId])
  @@index([questionId])
  @@index([experienceId])
  @@index([processId])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  description String     @default("")
  position    Int        @default(0)
  questions   Question[]

  @@index([parentId])
}

model Tag {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  questions QuestionTag[]
}

model Company {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  website        String
  careersUrl     String
  logoUrl        String        @default("")
  industry       String
  description    String        @default("")
  headquarters   String        @default("")
  hiringInfo     String        @default("")
  roleCategories String[]
  prepCategories String[]
  origin         ContentOrigin
  verification   Verification  @default(NOT_VERIFIED)
  publication    Publication   @default(DRAFT)
  lastVerifiedAt DateTime?
  publishedAt    DateTime?
  // Private. Never selected into public queries.
  moderatorNotes String        @default("")
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

sources     ContentSource[]
  processes   InterviewProcess[]
  experiences Experience[]
  questions   QuestionCompany[]
  mockInterviewSessions MockInterviewSession[]
  careerOpportunities CareerOpportunity[]
  jobApplications JobApplication[]

  @@index([publication, name])
  @@index([industry])
}

model InterviewProcess {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title             String
  roleFamily        String        @default("")
  experienceLevels  ExperienceLevel[]
  careerStages      CareerStage[]
  sequence          Int?
  kind              RoundKind
  description       String
  skillsEvaluated   String[]
  prepRecommendations String      @default("")
  origin            ContentOrigin
  verification      Verification  @default(NOT_VERIFIED)
  publication       Publication   @default(DRAFT)
  lastReviewedAt    DateTime?
  publishedAt       DateTime?
  moderatorNotes    String        @default("")
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sources ContentSource[]

  @@index([companyId, publication, sequence])
}

model Question {
  id               String        @id @default(cuid())
  slug             String        @unique
  text             String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type             QuestionType
  difficulty       Difficulty
  roles            String[]
  careerStages     CareerStage[]
  experienceLevels ExperienceLevel[]
  skills           String[]
  answerOutline    String
  explanation      String        @default("")
  exampleAnswer    String        @default("")
  codeSolution     String        @default("")
  codeLanguage     String        @default("")
  testCases        Json          @default("[]")
  hints            String[]
  estimatedMinutes Int           @default(5)
  origin           ContentOrigin
  verification     Verification  @default(NOT_VERIFIED)
  publication      Publication   @default(DRAFT)
  publishedAt      DateTime?
  moderatorNotes   String        @default("")
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  options           QuestionOption[]
  tags              QuestionTag[]
  companies         QuestionCompany[]
  sources           ContentSource[]
  saved             SavedQuestion[]
  assessmentQuestions AssessmentQuestion[]
  communityPosts    CommunityPost[]
  groupDiscussions  GroupDiscussion[]

  @@index([publication, publishedAt(sort: Desc)])
  @@index([categoryId, publication])
  @@index([difficulty, publication])
  @@index([type, publication])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean  @default(false)
  position   Int

  @@unique([questionId, position])
}

model QuestionTag {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

// A company link is a claim. The service only allows it when a supporting source exists.
model QuestionCompany {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([questionId, companyId])
  @@index([companyId])
}

model Experience {
  id                String        @id @default(cuid())
  slug              String        @unique
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role              String
  careerStage       CareerStage?
  experienceLevel   ExperienceLevel?
  reportedYear      Int?
  summary           String
  rounds            Json          @default("[]")
  topics            String[]
  reportedQuestions String[]
  advice            String        @default("")
  sourceUrl         String        @default("")
  sourceRef         String        @default("")
  origin            ContentOrigin
  verification      Verification  @default(NOT_VERIFIED)
  publication       Publication   @default(DRAFT)
  lastReviewedAt    DateTime?
  publishedAt       DateTime?
  moderatorNotes    String        @default("")
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sources ContentSource[]

  @@index([companyId, publication])
  @@index([publication, publishedAt(sort: Desc)])
}

model SavedQuestion {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, questionId])
  @@index([questionId])
}

model ContentRevision {
  id        String   @id @default(cuid())
  kind      String
  entityId  String
  version   Int
  actorId   String?
  changed   String[]
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([kind, entityId, version])
  @@index([kind, entityId])
}

// Administrative changes. Separate from the user facing AuditLog above. Never exposed outside /admin.
model ContentAudit {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model ImportJob {
  id        String       @id @default(cuid())
  sourceId  String
  source    Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  kind      ImportKind
  filename  String
  fileHash  String
  status    ImportStatus
  message   String       @default("")
  total     Int          @default(0)
  valid     Int          @default(0)
  invalid   Int          @default(0)
  duplicate Int          @default(0)
  skipped   Int          @default(0)
  created   Int          @default(0)
  createdBy String?
  createdAt DateTime     @default(now())
  committedAt DateTime?

  records ImportRecord[]

  @@index([sourceId, kind, fileHash])
  @@index([status])
}

// The staging area. Uploaded files themselves are never stored, only parsed rows.
model ImportRecord {
  id          String       @id @default(cuid())
  jobId       String
  job         ImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  row         Int
  status      StagedStatus
  data        Json?
  errors      String[]
  duplicateOf String?
  preview     String       @default("")

  @@unique([jobId, row])
}


// ============================================================================
// PHASE 3: AI practice sessions, evaluations, generated questions, plans, usage
// ============================================================================

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum PlanTaskStatus {
  TODO
  DONE
}

model PracticeSession {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String         @default("")
  topic      String         @default("")
  difficulty Difficulty?
  questionType QuestionType?
  status     PracticeStatus @default(IN_PROGRESS)
  startedAt  DateTime       @default(now())
  completedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  questions PracticeSessionQuestion[]
  answers   UserPracticeAnswer[]

  @@index([userId, status, createdAt(sort: Desc)])
}

model PracticeSessionQuestion {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position  Int
  questionId String?
  generatedQuestionId String?
  generatedQuestion GeneratedPracticeQuestion? @relation(fields: [generatedQuestionId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@unique([sessionId, position])
  @@index([sessionId])
}

model UserPracticeAnswer {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionRef String
  answerText String
  submittedAt DateTime      @default(now())
  evaluation AnswerEvaluation?

  @@unique([sessionId, questionRef])
  @@index([sessionId])
}

model AnswerEvaluation {
  id        String            @id @default(cuid())
  answerId  String            @unique
  answer    UserPracticeAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  score     Int
  band      String
  criteria  Json              @default("[]")
  strengths String[]
  missing   String[]
  incorrect String[]
  improvements String[]
  modelAnswer String         @default("")
  nextSteps String[]
  confidence Float?
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
}

model GeneratedPracticeQuestion {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  type      QuestionType
  difficulty Difficulty
  topic     String
  subtopic  String        @default("")
  skills    String[]
  estimatedMinutes Int    @default(5)
  hints     String[]
  answerOutline String    @default("")
  explanation String      @default("")
  exampleAnswer String    @default("")
  codeSolution String     @default("")
  codeLanguage String     @default("")
  testCases Json          @default("[]")
  rubric    Json          @default("[]")
  origin    ContentOrigin @default(AI_GENERATED)
  contentOrigin String     @default("AI_GENERATED")
  createdAt DateTime      @default(now())

  sessionQuestions PracticeSessionQuestion[]

  @@index([userId, createdAt(sort: Desc)])
}

model PreparationPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PlanStatus @default(ACTIVE)
  version   Int        @default(1)
  goal      String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  versions PreparationPlanVersion[]
  tasks    PreparationPlanTask[]

  @@index([userId, status])
}

model PreparationPlanVersion {
  id        String          @id @default(cuid())
  planId    String
  plan      PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  createdAt DateTime        @default(now())

  @@unique([planId, version])
}

model PreparationPlanTask {
  id        String          @id @default(cuid())
  planId    String
  plan      PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  description String        @default("")
  topic     String         @default("")
  estimatedMinutes Int     @default(15)
  status    PlanTaskStatus @default(TODO)
  completedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([planId, position])
  @@index([planId, status])
}

model AIUsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation String
  model     String   @default("")
  inputTokens Int    @default(0)
  outputTokens Int   @default(0)
  totalTokens Int    @default(0)
  estimatedCostUsd Float?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model AIRequestLog {
  id        String   @id @default(cuid())
  userId    String?
  operation String
  status    String
  errorCode String?
  durationMs Int?
  createdAt DateTime @default(now())

  @@index([operation, createdAt(sort: Desc)])
}


// ============================================================================
// PHASE 4: Assessment & Testing Engine
// ============================================================================

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  APTITUDE
  TECHNICAL
  CODING
  READINESS
  CUSTOM
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  EVALUATING
  COMPLETED
}

model Assessment {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @default("")
  type        AssessmentType
  difficulty  Difficulty       @default(BEGINNER)
  careerStages CareerStage[]
  status      AssessmentStatus @default(DRAFT)
  timeLimitMinutes Int         @default(30)
  passingScore Int             @default(60)
  negativeMarking Boolean      @default(false)
  allowBackNavigation Boolean  @default(true)
  showExplanationsAfter Boolean @default(true)
  maxAttempts Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sections    AssessmentSection[]
  questions   AssessmentQuestion[]
  attempts    AssessmentAttempt[]

  @@index([status, type])
}

model AssessmentSection {
  id          String      @id @default(cuid())
  assessmentId String
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title       String
  position    Int
  questionCount Int       @default(0)

  @@unique([assessmentId, position])
}

model AssessmentQuestion {
  id          String      @id @default(cuid())
  assessmentId String
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId  String?
  question    Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  position    Int
  marks       Int         @default(1)
  isRequired  Boolean     @default(true)

  @@unique([assessmentId, position])
  @@index([assessmentId])
}

model AssessmentAttempt {
  id          String        @id @default(cuid())
  assessmentId String
  assessment  Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  score       Int?
  maxScore    Int?
  percentage  Float?
  passed      Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  answers     AttemptAnswer[]
  result      AssessmentResult?

  @@index([userId, status])
  @@index([assessmentId, status])
}

model AttemptAnswer {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  answerText  String            @default("")
  selectedOptionIds String[]    @default([])
  isMarkedForReview Boolean    @default(false)
  savedAt     DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AssessmentResult {
  id          String            @id @default(cuid())
  attemptId   String            @unique
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalScore  Int
  maxScore    Int
  percentage  Float
  passed      Boolean
  breakdown   Json              @default("[]")
  createdAt   DateTime          @default(now())
}

model CodeExecutionJob {
  id          String   @id @default(cuid())
  attemptId   String?
  language    String
  code        String
  status      String   @default("PENDING")
  output      String   @default("")
  error       String   @default("")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}


// ============================================================================
// PHASE 5: Resume Management, ATS-Style Analysis, Job Matching & Career Gaps
// ============================================================================

enum ResumeStatus {
  UPLOADED
  QUEUED
  EXTRACTING
  READY_FOR_ANALYSIS
  ANALYZING
  COMPLETED
  FAILED
  DELETED
}

enum ResumeAnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JobDescriptionSource {
  PASTED
  URL
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

model Resume {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  fileSize        Int
  mimeType        String
  storageKey      String        @unique
  status          ResumeStatus  @default(UPLOADED)
  extractedText   String?
  extractedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  versions        ResumeVersion[]        @relation("ResumeVersions")
  processingJobs  ResumeProcessingJob[]  @relation("ResumeProcessingJobs")

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model ResumeVersion {
  id              String        @id @default(cuid())
  resumeId        String
  resume          Resume        @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber   Int
  fileName        String
  fileSize        Int
  mimeType        String
  storageKey      String
  extractedText   String?
  targetRole      String?
  isActive        Boolean       @default(false)
  createdAt       DateTime      @default(now())

@@unique([resumeId, versionNumber])
  @@index([resumeId])
  extractedProfile ResumeExtractedProfile? @relation("ResumeVersionExtractedProfile")
  analyses        ResumeAnalysis[]          @relation("ResumeAnalyses")
  jobMatches      JobMatch[]                @relation("ResumeJobMatches")
  skillGaps       SkillGap[]                @relation("SkillGaps")
  mockInterviewSessions MockInterviewSession[]
  jobApplications JobApplication[]
  jobDescriptionAnalyses JobDescriptionAnalysis[]
}

model ResumeExtractedProfile {
  id              String        @id @default(cuid())
  resumeVersionId String        @unique
  resumeVersion   ResumeVersion @relation("ResumeVersionExtractedProfile", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  // Structured extracted data (validated against Zod schema)
  profileJson     Json
  // Raw extracted text for reference
  rawText         String?
  // Extraction metadata
  extractionModel String?
  extractionAt    DateTime      @default(now())
  confidence      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ResumeAnalysis {
  id              String              @id @default(cuid())
  resumeVersionId String
  resumeVersion   ResumeVersion       @relation("ResumeAnalyses", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  targetRole      String?
  status          ResumeAnalysisStatus @default(PENDING)
  // Analysis results (validated against Zod schema)
  analysisJson    Json?
  rubricVersion   String              @default("1.0")
  overallScore    Int?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  categories      ResumeAnalysisCategory[] @relation("AnalysisCategories")
  recommendations ResumeRecommendation[]   @relation("AnalysisRecommendations")
  rewrites        ResumeRewriteSuggestion[] @relation("AnalysisRewrites")

  @@index([resumeVersionId])
}

model ResumeAnalysisCategory {
  id          String        @id @default(cuid())
  analysisId  String
  analysis    ResumeAnalysis @relation("AnalysisCategories", fields: [analysisId], references: [id], onDelete: Cascade)
  category    String
  score       Int
  maxScore    Int
  weight      Float
  findings    Json          @default("[]")
  createdAt   DateTime      @default(now())

  @@unique([analysisId, category])
}

model ResumeRecommendation {
  id              String            @id @default(cuid())
  analysisId      String
  analysis        ResumeAnalysis    @relation("AnalysisRecommendations", fields: [analysisId], references: [id], onDelete: Cascade)
  title           String
  description     String
  priority        Int               @default(1)
  category        String
  evidence        Json              @default("[]")
  expectedEffort  String?
  status          RecommendationStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([analysisId])
}

model ResumeRewriteSuggestion {
  id              String        @id @default(cuid())
  analysisId      String
  analysis        ResumeAnalysis @relation("AnalysisRewrites", fields: [analysisId], references: [id], onDelete: Cascade)
  section         String
  originalText    String
  suggestedText   String
  rationale       String
  assumptions     Json          @default("[]")
  isAccepted      Boolean       @default(false)
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([analysisId])
}

model JobDescription {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
source      JobDescriptionSource
  rawText     String
  url         String?
  title       String?
  company     String?
  parsedJson  Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  matches              JobMatch[] @relation("JobDescriptionMatches")
  jobDescriptionAnalyses JobDescriptionAnalysis[]

  @@index([userId, createdAt(sort: Desc)])
}

model JobMatch {
  id              String        @id @default(cuid())
  resumeVersionId String
  resumeVersion   ResumeVersion @relation("ResumeJobMatches", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription  JobDescription @relation("JobDescriptionMatches", fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  matchJson       Json
  overallMatch    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([resumeVersionId, jobDescriptionId])
  @@index([resumeVersionId])
  @@index([jobDescriptionId])
}

model SkillGap {
  id              String        @id @default(cuid())
  resumeVersionId String
  resumeVersion   ResumeVersion @relation("SkillGaps", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  skill           String
  category        String
  targetRole      String?
  // Evidence sources
  resumeEvidence  Json          @default("[]")
  assessmentEvidence Json       @default("[]")
  practiceEvidence Json        @default("[]")
  // Gap classification
  classification  String        // DEMONSTRATED | SELF_REPORTED | MENTIONED_NOT_DEMONSTRATED | NOT_FOUND | NEEDS_ASSESSMENT
  confidence      Float?
  suggestedAction String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([resumeVersionId, skill])
  @@index([resumeVersionId, targetRole])
}

model ResumeProcessingJob {
  id              String   @id @default(cuid())
  resumeId        String
  resume          Resume   @relation("ResumeProcessingJobs", fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersionId String?
  type            String   // EXTRACTION | ANALYSIS | JOB_MATCH | SKILL_GAP | REWRITE
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED
  inputJson   Json?
  outputJson  Json?
  errorMessage String?
  attempts    Int      @default(0)
  maxRetries  Int      @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resumeId, type])
  @@index([resumeVersionId, type])
  @@index([status, createdAt])
}


